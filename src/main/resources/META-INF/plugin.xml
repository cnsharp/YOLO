<idea-plugin>
    <id>com.cnsharp.yolo.exp</id>
    <!-- <name> is injected at build time: build.gradle.kts reads and overwrites it from
         messages/YoloBundle.properties' plugin.name, so the product name is maintained only in
         that single key. This is just a placeholder. -->
    <name>YOLO: AI Agents Extender</name>
    <!-- <version> is also injected at build time: from pluginVersion in gradle.properties. This is just a placeholder. -->
    <version>0.0.0</version>
    <vendor email="support@cnsharp.com" url="">CnSharp Studio</vendor>
    <description><![CDATA[
<p><b>YOLO</b> extends IntelliJ IDEA's Terminal <b>AI Agents</b> dropdown with your own tools, and lets you launch them in <b>YOLO mode</b> with a single click.</p>
<ul>
  <li><b>AI Agents extension</b> — Add any AI CLI (Claude Code, Codex, CodeBuddy, Qoder, or your own) to the Terminal panel's AI Agents menu.</li>
  <li><b>YOLO mode</b> — A "Skip permissions" toggle sits in the Terminal toolbar, left of the AI Agents dropdown. When on, the next agent launches with its skip-permissions flag (e.g. <code>--dangerously-skip-permissions</code>, <code>--yolo</code>, <code>-y</code>). Per-agent, fully configurable, and <b>off by default</b>.</li>
</ul>

<p><b>⚠️ Warning — about "YOLO mode" / the skip-permissions flag:</b> letting an AI agent run commands and edit files <b>without confirmation</b> can make irreversible changes, execute untrusted code, or expose your system. These risks come entirely from the agent and the bypass flag itself. <b>This plugin only flips that flag for you — it adds no such behavior of its own</b>, performs no actions on your behalf, and is not responsible for what the agent does. Enable YOLO mode only in trusted environments.</p>
]]></description>

    <!-- Verified locally only from 2026.2 (build 262) for the terminal AI Agents extension points;
         the user requested support starting from 2026.1 (build 261). until-build is left unlocked
         to avoid blocking subsequent minor versions. -->
    <idea-version since-build="261"/>
    <!-- Declares a platform module dependency to avoid the warning that this would be treated as a legacy plugin loadable only in IntelliJ IDEA -->
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <!-- Default (English) resource bundle for all user-visible text; YoloBundle_zh.properties provides Chinese.
         The action's text/description is also resolved by the platform from here via action.<id>.text. -->
    <resource-bundle>messages.YoloBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.cnsharp.yolo.settings.AgentExtenderSettingsExp"/>
        <!-- displayName is omitted: key points to YoloBundle's plugin.name, so the product name is maintained only in that one place -->
        <applicationConfigurable instance="com.cnsharp.yolo.settings.AgentExtenderConfigurable"
                      groupId="tools"
                      key="plugin.name"
                      bundle="messages.YoloBundle"
                      id="com.cnsharp.yolo.exp.configurable"/>
        <notificationGroup id="com.cnsharp.yolo.exp.notifications" displayType="BALLOON"/>
    </extensions>

    <!-- Extension points used by the terminal AI Agents dropdown (all from org.jetbrains.plugins.terminal).
         These terminal extension points (TerminalAgentProvider, ShellExecOptionsCustomizer,
         TerminalToolWindowInitializer) are still @ApiStatus.Internal experimental APIs in 2026.2,
         so IDEA warns about them. This plugin hard-depends on them with no public alternative, hence
         the per-line suppression of that inspection. -->
    <extensions defaultExtensionNs="org.jetbrains.plugins.terminal">
        <!-- suppress PluginXmlApiIsInternal -->
        <terminalAgentProvider implementation="com.cnsharp.yolo.terminal.CustomTerminalAgentProvider"/>
        <!-- suppress PluginXmlApiIsInternal -->
        <shellExecOptionsCustomizer implementation="com.cnsharp.yolo.terminal.TerminalSkipFlagCustomizer"/>
        <!-- order=last: must run after the terminal's own Initializer, otherwise setTitleActions would be overwritten -->
        <!-- suppress PluginXmlApiIsInternal -->
        <toolWindowInitializer implementation="com.cnsharp.yolo.terminal.SkipToggleToolWindowInitializer"
                               order="last"/>
    </extensions>


    <actions>
        <!-- text/description omitted: resolved by the <resource-bundle> above via
             action.com.cnsharp.yolo.exp.SkipPermissionsAction.text/.description -->
        <action id="com.cnsharp.yolo.exp.SkipPermissionsAction"
                class="com.cnsharp.yolo.launcher.SkipPermissionsAction"/>
        <action id="com.cnsharp.yolo.exp.OpenSettingsAction"
                class="com.cnsharp.yolo.settings.OpenSettingsAction"/>
    </actions>
</idea-plugin>
